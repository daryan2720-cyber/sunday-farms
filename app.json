{
  "expo": {
    "name": "Sunday Farms",
    "slug": "sunday-farms",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "sundayfarms",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.sundayfarms.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Used only to connect to your Sunday Farms soil moisture sensor."
      }
    },
    "android": {
      "package": "com.sundayfarms.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2E7D32"
      },
      "allowBackup": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false,
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Used to scan QR codes on produce and to photograph your plants. Photos stay on your phone.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Used to photograph your plants for your grow journal and the plant health check.",
          "photosPermission": "Used to pick a plant photo for your grow journal."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock Sunday Farms with Face ID instead of typing your password."
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#2E7D32"
        }
      ]
    ]
  }
}
